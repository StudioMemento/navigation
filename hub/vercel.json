{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --ignore-scripts",
  "outputDirectory": "dist",
  "headers": [
    {"source":"/navigation/:path*","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
    {"source":"/:path*","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ],
  "rewrites": [
    {"source":"/studio/:path*","destination":"/index.html"},
    {"source":"/memento/:path*","destination":"/index.html"},
    {"source":"/services/:path*","destination":"/index.html"},
    {"source":"/projects/:path*","destination":"/index.html"},
    {"source":"/levelup/:path*","destination":"/index.html"},
    {"source":"/start/:path*","destination":"/index.html"}
  ]
}
