{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/memento/",
      "destination": "/studio/",
      "permanent": true
    },
    {
      "source": "/index/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    },
    {
      "source": "/projects/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    },
    {
      "source": "/levelup/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    },
    {
      "source": "/start/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/photographs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/compiled/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/memento-ui/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/navigation/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/(services|projects|levelup|start|studio)/(.*)\\.(js|mjs|css|svg|json|webp|png|jpg|jpeg|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://*.vercel.app https://*.chatgpt.site https://www.google.com https://maps.google.com https://www.google.it https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "mementostudio.it"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
