{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "node --version",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/memento",
      "destination": "https://mementostudio.vercel.app/",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "https://mementoservizi.vercel.app/",
      "permanent": false
    },
    {
      "source": "/projects",
      "destination": "https://mementoportfolio.vercel.app/",
      "permanent": false
    },
    {
      "source": "/levelup",
      "destination": "https://mementolevelup.vercel.app/",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "https://mementostart.vercel.app/",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "https://mementostudio.vercel.app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/family_v007/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/world_v008/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
