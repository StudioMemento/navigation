{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/memento/",
      "destination": "/studio/",
      "permanent": true
    },
    {
      "source": "/index/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    },
    {
      "source": "/projects/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    },
    {
      "source": "/levelup/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    },
    {
      "source": "/start/assets/fonts/InterVariable.woff2",
      "destination": "/assets/fonts/InterVariable.woff2",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/memento-ui/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/navigation/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://*.vercel.app https://*.chatgpt.site https://www.google.com https://maps.google.com https://www.google.it https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "mementostudio.it"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/studio/",
      "destination": "/api/section?station=studio"
    },
    {
      "source": "/services/",
      "destination": "/api/section?station=services"
    },
    {
      "source": "/projects/",
      "destination": "/api/section?station=projects"
    },
    {
      "source": "/levelup/",
      "destination": "/api/section?station=levelup"
    },
    {
      "source": "/start/",
      "destination": "/api/section?station=start"
    },
    {
      "source": "/studio/:file+",
      "destination": "https://mementostudio.vercel.app/:file+"
    },
    {
      "source": "/services/:file+",
      "destination": "https://mementoservizi.vercel.app/:file+"
    },
    {
      "source": "/projects/:file+",
      "destination": "https://mementoportfolio.vercel.app/:file+"
    },
    {
      "source": "/levelup/:file+",
      "destination": "https://mementolevelup.vercel.app/:file+"
    },
    {
      "source": "/start/:file+",
      "destination": "https://mementostart.vercel.app/:file+"
    }
  ]
}
