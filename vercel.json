{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/memento/", "destination": "/studio/", "permanent": true },
    { "source": "/index/", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-src 'self' https://*.vercel.app https://*.chatgpt.site https://www.google.com https://maps.google.com https://www.google.it https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "mementostudio.it" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
