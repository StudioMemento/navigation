{
  "name": "memento-studioweb",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Studio 3D of mementostudio.it: the isometric studio, built into public/studio/app/.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "build:raster": "asc src/software/raster.ts -o studio/model/raster.wasm --runtime stub --optimize --noAssert"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "assemblyscript": "0.28.8",
    "meshoptimizer": "0.24.0",
    "vite": "7.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
